# Copy this file to demo.env on each machine and adjust only the values needed there.
# Do not put passwords, private keys, or tokens in this file.

# Optional explicit interpreter. Otherwise the scripts locate the named conda environment.
CONDA_ENV_NAME=yolo26
# YOLO26_PYTHON=/absolute/path/to/envs/yolo26/bin/python

# Shared cloud endpoint as seen from the local edge machine.
# Keep this localhost URL when using: ssh -N -L 8765:127.0.0.1:8765 USER@SERVER
CLOUD_URL=http://127.0.0.1:8765/infer
CLOUD_TIMEOUT=8.0
CLOUD_IMGSZ=640

# Local edge UI.
EDGE_MODEL=yolo26n.pt
POLICY_PATH=examples/YOLO26-Edge-Cloud/policies/current_maur_v2/manifest.json
EDGE_DEVICE=
UI_HOST=127.0.0.1
UI_PORT=7860
UI_MAX_FILE_SIZE=512mb
OPEN_BROWSER=1
REQUIRE_CLOUD=0
SAVE_DIR=runs/edge_cloud/gradio_demo
# Camera mode enforces this cumulative raw-JPEG byte fraction on every processed prefix.
ONLINE_FIXED_BYTE_BUDGET=0.1
# Keep at 0 for budget-safe camera operation. Set to 1 only for legacy lambda experiments.
DISABLE_ONLINE_BUDGET=0

# Remote cloud process. The safe default is for an SSH tunnel.
CLOUD_MODEL=yolo26x.pt
CLOUD_DEVICE=0
CLOUD_HOST=127.0.0.1
CLOUD_PORT=8765
# CAVS/MAUR needs raw 0.001 detector outputs; the UI separately filters displayed boxes.
CLOUD_CONF=0.001
CLOUD_MIN_IMGSZ=320
CLOUD_MAX_IMGSZ=960
CLOUD_MAX_REQUEST_MB=20
